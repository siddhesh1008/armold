<?xml version="1.0"?>
<!--
  Armold — central parameter table.

  ============================ MASS TABLE ============================
  Every mass in the model lives here, so there is exactly one place to edit as
  parts get weighed. Each entry carries a tag:

    [MEASURED]  weighed on a scale — trustworthy.
    [ESTIMATE]  derived from mesh volume x material density at 100% infill.
                A printed part is NOT solid, so these read HIGH — typically by
                40-70% at normal infill. Treat as an upper bound only.

  When you weigh a part, replace the value and change its tag to [MEASURED].
  Nothing else in the model needs touching.
  ====================================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================ -->
  <!-- Printed structural parts                                          -->
  <!-- ================================================================ -->

  <!-- [ESTIMATE] J1 base, Hidden Bolts variant.
       Mesh solid volume 61 563.1 mm^3 = 61.5631e-6 m^3, x PLA 1240 kg/m^3.
       Bolted to the world, so this mass never affects the dynamics — it is
       recorded for completeness and for shipping-weight sums only. -->
  <xacro:property name="mass_j1_base" value="0.0763"/>

  <!-- [ESTIMATE] J1/J5 mounting bracket.
       Mesh solid volume 21 045.9 mm^3 = 21.0459e-6 m^3, x PLA 1240 kg/m^3.
       Static - it clamps the motor body and is part of the fixed base
       assembly - so like the base its mass never enters the dynamics. -->
  <xacro:property name="mass_j1_j5_bracket" value="0.0261"/>

  <!-- [ESTIMATE] J2 base T-joint - the first MOVING link.
       Mesh solid volume 112 430.4 mm^3 = 112.4304e-6 m^3, x PLA 1240 kg/m^3.
       This one rotates, so its mass and inertia genuinely matter: it is the
       entire load the J1 stepper has to accelerate. Weigh it. -->
  <xacro:property name="mass_j2_base_t_joint" value="0.1394"/>

  <!-- [ESTIMATE] C-joint - the arm segment used twice, at J3 and at J4.
       Mesh solid volume 275 405.6 mm^3 = 275.4056e-6 m^3, x PLA 1240 kg/m^3.
       227 mm long, so it swings a long lever arm; both its mass and where that
       mass sits dominate the J2 torque. Weigh it. -->
  <xacro:property name="mass_c_joint" value="0.3415"/>

  <!-- ================================================================ -->
  <!-- Motors                                                            -->
  <!-- ================================================================ -->

  <!-- [ESTIMATE] NEMA 17, 37.5 mm body — the J1 motor.
       Catalogue figures for this body length span roughly 0.22-0.28 kg, so this
       midpoint could be off by +/-12%. On a moving link the motor dominates link
       inertia, so WEIGH ONE and replace this before trusting any dynamics. -->
  <xacro:property name="mass_nema17_37_5" value="0.250"/>

  <!-- [ESTIMATE] NEMA 17, 60 mm body - the J2 motor, carried by the T-joint.
       A 60 mm can is among the longest NEMA 17s made; catalogue weights run
       roughly 0.40-0.50 kg, so this is a wide guess. It rides on a moving link
       AND is the heaviest single item so far - about 3x the T-joint itself - so
       it dominates the J1 inertia. This is the most valuable part to weigh. -->
  <xacro:property name="mass_nema17_60" value="0.450"/>

  <!-- ================================================================ -->
  <!-- Material densities (for volume-based estimates)                   -->
  <!-- ================================================================ -->
  <xacro:property name="density_pla"  value="1240.0"/>   <!-- kg/m^3 -->
  <xacro:property name="density_petg" value="1270.0"/>   <!-- kg/m^3 -->

</robot>
