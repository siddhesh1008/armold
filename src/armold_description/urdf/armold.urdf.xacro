<?xml version="1.0"?>
<!--
  Armold — robotic arm by Sweep Dynamics.

  Built base-upward, one joint at a time. Every dimension below was measured
  directly from the supplied STL geometry rather than assumed; the measurement is
  cited in a comment beside each value so it can be re-checked.

  UNITS: the STL files are authored in millimetres. URDF is metres, so every mesh
  carries scale="0.001 0.001 0.001" and every literal here is in metres.
-->
<robot name="armold" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Mass table (edit masses there, not here) and reusable components -->
  <xacro:include filename="$(find armold_description)/urdf/parameters.xacro"/>
  <xacro:include filename="$(find armold_description)/urdf/nema17.xacro"/>

  <!-- ================================================================== -->
  <!-- Conversions and shared properties                                   -->
  <!-- ================================================================== -->

  <!-- STL authoring units (mm) expressed in metres -->
  <xacro:property name="mm" value="0.001"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="mesh_dir" value="package://armold_description/meshes"/>

  <!-- ================================================================== -->
  <!-- Measured geometry: J1 base (Hidden Bolts variant)                   -->
  <!-- ================================================================== -->
  <!--
    Source mesh : J1 - Base Hidden Bolts.stl  (17794 triangles)
    Measured    : outer cylinder least-squares fit over 1346 rim vertices
                    centre   (+0.000006, +0.000046) mm  -> 0.05 microns off axis
                    radius   30.99845 mm   (diameter 61.9969 mm, nominal 62)
                    rms circularity error 2.63 microns
                  bbox z     0.000 .. 60.750 mm
                  top face   annulus, inner bore radius 25.000 mm at z = 60.750
                  bottom     annulus, outer 30.500 mm at z = 0 (0.5 mm chamfer
                             rising to full 31.000 mm radius at z = 0.500)

    ORIGIN CONVENTION: the mesh is already centred on its own axis of revolution
    to within 0.05 microns, and its underside sits exactly on z = 0. So base_link's
    origin is the centre of the base circle at the mounting plane, with +Z up
    along the axis of rotation, and the mesh needs NO offset - it is used as-is.
  -->
  <xacro:property name="j1_base_radius"     value="${30.99845 * mm}"/>
  <xacro:property name="j1_base_height"     value="${60.750 * mm}"/>
  <xacro:property name="j1_base_top_bore_r" value="${25.000 * mm}"/>

  <!-- Mass lives in the table in parameters.xacro -->
  <xacro:property name="j1_base_mass" value="${mass_j1_base}"/>

  <!-- ================================================================== -->
  <!-- Materials                                                           -->
  <!-- ================================================================== -->

  <material name="armold_black">
    <color rgba="0.15 0.15 0.17 1.0"/>
  </material>

  <!-- ================================================================== -->
  <!-- Links                                                               -->
  <!-- ================================================================== -->

  <!--
    world — the fixed ground frame the arm is bolted to.

    Two reasons this exists. Geometrically it is the mounting plane, which is what
    an arm bolted to a bench actually has. Practically, robot_state_publisher only
    publishes one transform per joint: a robot that is a single root link has no
    joints, so TF stays completely empty and RViz reports
    "Fixed Frame [base_link] does not exist". Anchoring base_link to world with a
    fixed joint puts world -> base_link on /tf_static, so both frames exist and
    the warning goes away.
  -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <!-- base_link's frame is the centre of the base circle lying in the mounting
         plane, so it coincides exactly with world. -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    base_link — the static J1 base. Its frame is the centre of the base circle,
    lying in the mounting plane, +Z along the axis about which J1 will rotate.
  -->
  <link name="base_link">

    <visual>
      <!-- no offset: the mesh is already authored about this exact frame -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/j1_base_hidden_bolts.stl"
              scale="${mesh_scale}"/>
      </geometry>
      <material name="armold_black"/>
    </visual>

    <!--
      Collision uses a cylinder primitive rather than the mesh: it matches the
      measured envelope (r 30.998 mm, h 60.750 mm) and is far cheaper to check
      than 17794 triangles. Centred at half height because URDF cylinders are
      centred on their own origin, while the mesh sits on z = 0.
    -->
    <collision>
      <origin xyz="0 0 ${j1_base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${j1_base_radius}" length="${j1_base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${j1_base_height / 2}" rpy="0 0 0"/>
      <mass value="${j1_base_mass}"/>
      <!-- solid-cylinder approximation about the link frame -->
      <inertia
        ixx="${j1_base_mass * (3 * j1_base_radius * j1_base_radius + j1_base_height * j1_base_height) / 12}"
        iyy="${j1_base_mass * (3 * j1_base_radius * j1_base_radius + j1_base_height * j1_base_height) / 12}"
        izz="${j1_base_mass * j1_base_radius * j1_base_radius / 2}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>

  </link>

  <!-- ================================================================== -->
  <!-- J1 stepper mount - STATIC                                           -->
  <!-- ================================================================== -->
  <!--
    Source mesh : J1 J5 - Mounting Bracket.stl  (11008 triangles)
    Measured    : outer edge least-squares fit over 374 rim vertices
                    centre   (+0.000000, -0.000000) mm  -> 0.00 microns off axis
                    radius   31.00001 mm  (diameter 62.0000)
                    rms circularity error 0.0 microns  (exact)
                  bbox z     0.000 .. 8.050 mm  (a flat disc)
                  underside  flat annulus r 11.750..30.850 at z = 0, and NOTHING
                             protrudes below z = 0 - so there is no centring
                             spigot; the disc simply seats on the base top face.
                  motor      4 holes at (+/-15.500, +/-15.500) mm = a 31.0 mm
                             square pattern, dia 3.00 mm, counterbored to
                             6.50 mm at the top face. That is the NEMA 17
                             bolt pattern (31.04 mm nominal).
                  8 x dia 2.10 mm holes on a 56 mm bolt circle (r = 28.000)

    PLACEMENT: the bracket's underside is flat and its mesh origin is already on
    the common axis to 0.00 microns, so it needs no offset of its own. The joint
    simply lifts it to the base's top face at z = 60.750 mm. Mesh used exactly as
    authored - the geometry is preserved, only the frame moves.

    THIS PART DOES NOT ROTATE. It is the stepper's mount: it clamps the motor
    BODY, so it is rigidly part of the static base assembly. The 31.0 mm square
    hole pattern measured above is what bolts the motor to it. J1's actual
    rotation is driven by the motor SHAFT, which turns whatever mounts above -
    so the revolute joint belongs on that next part, not here.
  -->
  <xacro:property name="j1_bracket_radius"    value="${31.00001 * mm}"/>
  <xacro:property name="j1_bracket_thickness" value="${8.050 * mm}"/>

  <!--
    Fixed, not revolute: the bracket holds the motor body, so it never moves
    relative to the base.
  -->
  <joint name="base_to_j1_mount" type="fixed">
    <parent link="base_link"/>
    <child  link="j1_mounting_bracket"/>
    <origin xyz="0 0 ${j1_base_height}" rpy="0 0 0"/>
  </joint>

  <link name="j1_mounting_bracket">

    <visual>
      <!-- mesh authored about this exact frame; used unmodified -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/j1_j5_mounting_bracket.stl"
              scale="${mesh_scale}"/>
      </geometry>
      <material name="armold_black"/>
    </visual>

    <!--
      A cylinder is not an approximation here: the part is a plain disc, so
      r = 31.000 mm, h = 8.050 mm IS its exact envelope. Only internal pockets
      and bolt holes are lost, and those cannot participate in a collision.
    -->
    <collision>
      <origin xyz="0 0 ${j1_bracket_thickness / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${j1_bracket_radius}" length="${j1_bracket_thickness}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${j1_bracket_thickness / 2}" rpy="0 0 0"/>
      <mass value="${mass_j1_j5_bracket}"/>
      <inertia
        ixx="${mass_j1_j5_bracket * (3 * j1_bracket_radius * j1_bracket_radius + j1_bracket_thickness * j1_bracket_thickness) / 12}"
        iyy="${mass_j1_j5_bracket * (3 * j1_bracket_radius * j1_bracket_radius + j1_bracket_thickness * j1_bracket_thickness) / 12}"
        izz="${mass_j1_j5_bracket * j1_bracket_radius * j1_bracket_radius / 2}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>

  </link>

  <!--
    NEXT: the J1 revolute joint itself - about +Z, driven by the motor shaft,
    carrying whatever mounts on the shaft above this bracket.
  -->

</robot>
