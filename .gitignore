# ---- colcon / ROS 2 build artifacts ----
build/
install/
log/
devel/
logs/

# generated by ament/colcon inside packages
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/

# ---- direnv ----
# .envrc IS committed (it is project config); only direnv's local cache is not.
.direnv/

# ---- URDF / mesh scratch output ----
# expanded xacro output from `just urdf` / `just check-urdf`
*.urdf.generated

# ---- editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store

# ---- proprietary geometry (Sweep Dynamics) ----
# Armold's mesh and CAD files are a paid design and must never be committed.
# The folders under src/armold_description/meshes/ are kept via .gitkeep; the
# geometry itself stays local. If a file here is genuinely shareable, add it
# deliberately with `git add -f`.
*.stl
*.STL
*.dae
*.obj
*.ply
*.fbx
*.glb
*.gltf
*.3mf
*.step
*.stp
*.STEP
*.iges
*.igs
*.x_t
*.x_b
*.sldprt
*.sldasm
*.ipt
*.iam
*.f3d
*.f3z
