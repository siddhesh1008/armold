# Armold — direnv environment
#
# Sourced automatically by direnv on `cd` into this directory, and unwound when
# you leave. Requires a one-time `direnv allow` (bootstrap.sh does it for you).
#
# This makes the ROS 2 environment ambient: plain `ros2`, `rviz2`, and `colcon`
# work in this folder without sourcing anything by hand. The `just` recipes still
# source setup_env.sh themselves, so they work regardless of direnv.

# Re-evaluate this environment when either file changes. install/setup.bash does
# not exist until the first build, and direnv watches for its creation too — so
# the workspace overlay is picked up right after `just build`.
watch_file setup_env.sh
watch_file install/setup.bash

source ./setup_env.sh

# direnv runs .envrc with stdout captured, so status goes to stderr.
echo "armold: ROS 2 ${ROS_DISTRO} ready (domain ${ROS_DOMAIN_ID})" >&2
